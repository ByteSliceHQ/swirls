// Example: root node `code` points at a sibling `.ts.swirls` file (see normalize-email.ts.swirls).

workflow external_code_demo {
  label: "External TS file demo"

  root {
    type: code
    label: "Normalize email"
    inputSchema: @json {
      {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
    outputSchema: @json {
      {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
    code: @ts "./normalize-email.ts.swirls"
  }
}
