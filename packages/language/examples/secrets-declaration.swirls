// Example: declare which project secrets a node may read via context.secrets.<block>.<var>.
// Vendor keys (e.g. OPENROUTER_API_KEY for ai) must also be declared in a secret block.
// Use `type: managed` for Enterprise platform-supplied keys.

secret my_svc {
  vars: [MY_SERVICE_TOKEN]
}

secret llm_keys {
  type: managed
  vars: [OPENROUTER_API_KEY]
}

workflow secrets_example {
  label: "Secrets declaration"

  root {
    type: code
    label: "Entry"
    secrets: {
      my_svc: [MY_SERVICE_TOKEN]
    }
    inputSchema: @json {
      {
        "type": "object",
        "required": ["query"],
        "properties": { "query": { "type": "string" } },
        "additionalProperties": false
      }
    }
    code: @ts {
      const token = context.secrets.my_svc.MY_SERVICE_TOKEN
      return { query: context.nodes.root.input.query, hasToken: Boolean(token) }
    }
  }
}
