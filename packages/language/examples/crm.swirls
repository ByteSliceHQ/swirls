// CRM showcase: a Swirls-managed `database` as the system of record, governed
// `type: database` workflows for CRUD / pipeline ops, and an agent whose tools
// are those workflows. Chat via the web channel to create companies, contacts,
// and deals, search the book, and log activity.
//
// Requires OPENROUTER_API_KEY (see `secrets` → `crm_svc`).

secret crm_svc {
  label: "CRM vendor keys"
  vars: [ OPENROUTER_API_KEY ]
}

database crm {
  label: "CRM"
  description: "Companies, contacts, deals, and activity for a simple sales CRM."
  schema: @prisma {
    enum DealStage {
      LEAD
      QUALIFIED
      PROPOSAL
      NEGOTIATION
      WON
      LOST
    }

    enum ActivityType {
      CALL
      EMAIL
      MEETING
      NOTE
    }

    model Company {
      id        Int       @id @default(autoincrement())
      name      String
      domain    String?   @unique
      industry  String?
      createdAt DateTime  @default(now())
      contacts  Contact[]
      deals     Deal[]

      @@map("companies")
    }

    model Contact {
      id         Int        @id @default(autoincrement())
      email      String     @unique
      firstName  String
      lastName   String
      title      String?
      companyId  Int?
      company    Company?   @relation(fields: [companyId], references: [id])
      createdAt  DateTime   @default(now())
      deals      Deal[]
      activities Activity[]

      @@map("contacts")
    }

    model Deal {
      id         Int        @id @default(autoincrement())
      title      String
      amount     Int
      stage      DealStage  @default(LEAD)
      companyId  Int
      company    Company    @relation(fields: [companyId], references: [id])
      contactId  Int?
      contact    Contact?   @relation(fields: [contactId], references: [id])
      createdAt  DateTime   @default(now())
      closedAt   DateTime?
      activities Activity[]

      @@map("deals")
    }

    model Activity {
      id        Int          @id @default(autoincrement())
      type      ActivityType
      note      String
      contactId Int?
      contact   Contact?     @relation(fields: [contactId], references: [id])
      dealId    Int?
      deal      Deal?        @relation(fields: [dealId], references: [id])
      createdAt DateTime     @default(now())

      @@map("activities")
    }
  }

  connection app {
    label: "CRM application connection"
  }

  connection analytics {
    label: "CRM analytics connection"
  }
}

migration seed_sample_crm {
  database: crm
  order: 0
  operation: @ts {
    const existing = await context.db.crm.company.findFirst({
      where: { domain: "acme.example" },
    })
    if (existing) {
      return { seeded: false, reason: "acme already present", companyId: existing.id }
    }

    const acme = await context.db.crm.company.create({
      data: {
        name: "Acme Robotics",
        domain: "acme.example",
        industry: "Manufacturing",
        contacts: {
          create: {
            email: "maya@acme.example",
            firstName: "Maya",
            lastName: "Chen",
            title: "VP Engineering",
          },
        },
      },
      include: { contacts: true },
    })

    const contact = acme.contacts[0]!
    await context.db.crm.deal.create({
      data: {
        title: "Acme plant expansion",
        amount: 12500000,
        stage: "PROPOSAL",
        company: { connect: { id: acme.id } },
        contact: { connect: { id: contact.id } },
        activities: {
          create: {
            type: "MEETING",
            note: "Discovery call: interested in Q3 rollout.",
            contact: { connect: { id: contact.id } },
          },
        },
      },
    })

    return { seeded: true, companyId: acme.id, contactId: contact.id }
  }
}

disk crm_assets {
  label: "Company files"
}

policy {
  files {
    retention: 30d
  }
}

/* ---- Agent tool workflows (database-backed) ---- */

