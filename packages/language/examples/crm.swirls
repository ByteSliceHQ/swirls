      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "email", "firstName", "lastName"],
            "properties": {
              "id": { "type": "integer" },
              "email": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "title": { "type": ["string", "null"] },
              "company": {
                "type": ["object", "null"],
                "properties": {
                  "id": { "type": "integer" },
                  "name": { "type": "string" },
                  "domain": { "type": ["string", "null"] }
