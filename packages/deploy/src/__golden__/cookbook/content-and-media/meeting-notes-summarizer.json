        "name": "meeting_notes",
        "label": "Meeting Notes",
        "schema": {
          "type": "object",
          "required": ["title", "notes"],
          "properties": {
            "title": {
              "type": "string",
              "title": "Meeting Title"
            },
            "attendees": {
              "type": "string",
              "title": "Attendees (comma-separated)"
            },
            "notes": {
              "type": "string",
              "title": "Raw Notes"
            },
            "date": {
              "type": "string",
              "title": "Meeting Date"
            }
