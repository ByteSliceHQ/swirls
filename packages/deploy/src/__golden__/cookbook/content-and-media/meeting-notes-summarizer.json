        },
        "visibility": "internal"
      }
    ],
    "webhooks": [],
    "schedules": [],
    "workflows": [
      {
        "id": "id-2",
        "name": "summarize_meeting",
        "label": "Summarize Meeting",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract notes",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "attendees": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "summarize",
            "type": "ai",
            "label": "Generate summary",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const notes = context.nodes.root.output\n      return \"Summarize these meeting notes into a structured format.\\n\\nTitle: \" + notes.title + \"\\nAttendees: \" + (notes.attendees || \"not specified\") + \"\\nDate: \" + (notes.date || \"not specified\") + \"\\n\\nNotes:\\n\" + notes.notes\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["summary", "action_items", "decisions"],
              "properties": {
                "summary": {
                  "type": "string"
                },
                "action_items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "task": {
                        "type": "string"
                      },
                      "owner": {
                        "type": "string"
                      },
                      "deadline": {
                        "type": "string"
                      }
                    }
                  }
                },
                "decisions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "follow_ups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "format_output",
            "type": "code",
            "label": "Format final output",
            "config": {
              "type": "code",
              "code": "\n      const notes = context.nodes.root.output\n      const result = context.nodes.summarize.output\n      return {\n        title: notes.title,\n        date: notes.date || \"not specified\",\n        attendees: notes.attendees || \"not specified\",\n        summary: result.summary,\n        action_items: result.action_items,\n        decisions: result.decisions,\n        follow_ups: result.follow_ups || []\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
        "edges": [
