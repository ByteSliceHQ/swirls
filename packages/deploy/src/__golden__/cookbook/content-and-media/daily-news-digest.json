            "type": "code",
            "label": "Collect story titles",
            "config": {
              "type": "code",
              "code": "\n      const rows = context.nodes.fetch_details.output || []\n      const stories = rows\n        .map(function(row) { return row.root })\n        .filter(function(story) { return story && story.title })\n        .map(function(story) { return { title: story.title, url: story.url || \"\", score: story.score || 0 } })\n      return { stories: stories }\n    "
            },
            "reviewConfig": null
          },
