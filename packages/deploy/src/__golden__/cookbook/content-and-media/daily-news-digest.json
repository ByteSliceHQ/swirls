            "config": {
              "type": "ai",
              "kind": "text",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const stories = context.nodes.collect_stories.output.stories\n      const list = stories.map(function(s) { return \"- \" + s.title + \" (\" + s.score + \" points) \" + s.url }).join(\"\\n\")\n      return \"Write a brief daily tech news digest for \" + context.nodes.root.output.timestamp + \". Open with a 2-3 sentence intro, then list each story with a one-line takeaway.\\n\\nToday's top Hacker News stories:\\n\" + list\n    ",
              "temperature": 0.7
            },
            "reviewConfig": null,
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
