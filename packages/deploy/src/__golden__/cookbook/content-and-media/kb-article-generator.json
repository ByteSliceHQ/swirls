    "agentBlocks": [],
    "decisionBlocks": [],
    "queryBlocks": [],
    "channelBlocks": [],
    "connectionBlocks": [],
    "mcpBlocks": [],
    "networkBlocks": [],
    "connectorBlocks": [],
    "actionBlocks": [],
    "streams": [],
