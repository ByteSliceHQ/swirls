{
  "ok": true,
  "definition": {
    "forms": [
      {
        "id": "id-1",
        "name": "changelog_entry",
        "label": "Changelog Entry",
        "schema": {
          "type": "object",
          "required": ["version", "changes"],
          "properties": {
            "version": {
              "type": "string",
              "title": "Version"
            },
            "changes": {
              "type": "string",
              "title": "What Changed"
            },
            "breaking": {
              "type": "boolean",
              "title": "Breaking Changes?"
            }
          }
        },
        "visibility": "internal"
      }
    ],
    "webhooks": [],
    "schedules": [],
    "workflows": [
      {
        "id": "id-2",
        "name": "announce_release",
        "label": "Announce Release",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract changelog",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "changes": {
                  "type": "string"
                },
                "breaking": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "generate_announcement",
            "type": "ai",
            "label": "Generate announcement",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const entry = context.nodes.root.output\n      return \"Generate release announcements for version \" + entry.version + \".\\n\\nChanges:\\n\" + entry.changes + \"\\n\\nBreaking changes: \" + (entry.breaking ? \"yes\" : \"no\") + \"\\n\\nGenerate: a short Slack message (2-3 lines), an email body (1 paragraph), and a tweet (under 280 chars).\"\n    ",
              "temperature": 0.7
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["slack_message", "email_body", "tweet"],
              "properties": {
                "slack_message": {
                  "type": "string"
                },
                "email_body": {
                  "type": "string"
                },
                "tweet": {
                  "type": "string"
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "post_slack",
            "type": "http",
            "label": "Post to Slack",
            "config": {
              "type": "http",
              "url": " return context.secrets.announce_config.SLACK_WEBHOOK_URL ",
              "method": "POST",
              "headers": " return { \"Content-Type\": \"application/json\" } ",
              "body": "\n      return JSON.stringify({\n        text: context.nodes.generate_announcement.output.slack_message\n      })\n    "
            },
            "reviewConfig": null,
            "secretsMap": {
              "announce_config": ["SLACK_WEBHOOK_URL"]
            },
            "configValueKinds": {
              "url": "ts",
              "body": "ts"
            }
          },
          {
            "id": "id-6",
            "name": "send_email",
            "type": "email",
            "label": "Send email announcement",
            "config": {
              "type": "email",
              "from": " return \"no-reply@transactional.byteslice.co\" ",
              "to": " return \"team@example.com\" ",
              "subject": " return \"Release \" + context.nodes.root.output.version ",
              "text": " return context.nodes.generate_announcement.output.email_body "
            },
            "reviewConfig": null,
            "configValueKinds": {
              "from": "ts",
              "to": "ts",
              "subject": "ts",
              "text": "ts"
            }
          },
          {
            "id": "id-7",
            "name": "result",
            "type": "code",
            "label": "Compile results",
            "config": {
              "type": "code",
              "code": "\n      return {\n        version: context.nodes.root.output.version,\n        tweet_draft: context.nodes.generate_announcement.output.tweet,\n        tweet_length: context.nodes.generate_announcement.output.tweet.length,\n        slack_sent: true,\n        email_sent: true\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
        "edges": [
          {
            "id": "id-8",
            "sourceNodeId": "id-3",
            "targetNodeId": "id-4"
          },
