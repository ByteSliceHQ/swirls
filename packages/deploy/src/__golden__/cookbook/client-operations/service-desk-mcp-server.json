    "workflows": [
      {
        "id": "id-1",
        "name": "file_request",
        "label": "File Request",
        "description": "File a new service desk request and return its ticket id.",
        "nodes": [
          {
            "id": "id-2",
            "name": "root",
            "type": "code",
            "label": "Create ticket",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": "\n      const input = context.nodes.root.input\n      const ticketId = \"REQ_\" + Date.now().toString(36).toUpperCase()\n      return {\n        ticket_id: ticketId,\n        summary: input.summary,\n        urgency: input.urgency || \"normal\",\n        contact_email: input.contact_email || \"\",\n        filed_at: new Date().toISOString()\n      }\n    "
            },
            "reviewConfig": null,
            "inputSchema": {
              "type": "object",
              "required": ["summary", "urgency"],
              "properties": {
                "summary": {
                  "type": "string",
                  "description": "What the client needs, in one or two sentences."
                },
                "urgency": {
                  "type": "string",
                  "enum": ["low", "normal", "high"],
                  "description": "How urgent the request is."
                },
                "contact_email": {
                  "type": "string",
                  "description": "Who to follow up with."
                }
              }
            },
            "outputSchema": {
              "type": "object",
              "required": ["ticket_id", "summary", "urgency", "filed_at"],
              "properties": {
                "ticket_id": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "urgency": {
                  "type": "string"
                },
                "contact_email": {
                  "type": "string"
                },
                "filed_at": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-3",
            "name": "notify_desk",
            "type": "email",
            "label": "Notify service desk",
            "config": {
              "type": "email",
              "from": " return \"no-reply@transactional.byteslice.co\" ",
              "to": " return \"desk@your-msp.com\" ",
              "subject": "\n      const t = context.nodes.root.output\n      return \"[\" + t.urgency.toUpperCase() + \"] \" + t.ticket_id + \": \" + t.summary\n    ",
              "text": "\n      const t = context.nodes.root.output\n      return \"New service request \" + t.ticket_id + \"\\n\\nSummary: \" + t.summary + \"\\nUrgency: \" + t.urgency + \"\\nContact: \" + (t.contact_email || \"not provided\") + \"\\nFiled: \" + t.filed_at\n    "
            },
            "reviewConfig": null,
            "configValueKinds": {
              "from": "ts",
              "to": "ts",
              "subject": "ts",
              "text": "ts"
            }
          },
          {
            "id": "id-4",
            "name": "confirm",
            "type": "code",
            "label": "Confirm ticket",
            "config": {
              "type": "code",
              "code": "\n      const t = context.nodes.root.output\n      return {\n        ticket_id: t.ticket_id,\n        status: \"Filed with the service desk. Reference \" + t.ticket_id + \" to check progress.\"\n      }\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["ticket_id", "status"],
              "properties": {
                "ticket_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "edges": [
          {
            "id": "id-5",
            "sourceNodeId": "id-2",
            "targetNodeId": "id-3"
          },
          {
            "id": "id-6",
            "sourceNodeId": "id-3",
            "targetNodeId": "id-4"
          }
        ]
      },
      {
        "id": "id-7",
        "name": "check_request",
        "label": "Check Request",
        "description": "Look up a service desk request by its ticket id.",
        "nodes": [
          {
            "id": "id-8",
            "name": "root",
            "type": "code",
            "label": "Read ticket id",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return { ticket_id: context.nodes.root.input.ticket_id } "
            },
            "reviewConfig": null,
            "inputSchema": {
              "type": "object",
              "required": ["ticket_id"],
              "properties": {
                "ticket_id": {
                  "type": "string",
                  "description": "The REQ_ ticket id to look up."
                }
              }
            },
            "outputSchema": {
              "type": "object",
              "required": ["ticket_id"],
              "properties": {
                "ticket_id": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-9",
            "name": "find_ticket",
            "type": "stream",
            "label": "Find ticket",
            "config": {
              "type": "stream",
              "stream": "service_requests",
              "version": "v1",
              "filter": "\n      return { ticket_id: { eq: context.nodes.root.output.ticket_id } }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-10",
            "name": "answer",
            "type": "code",
            "label": "Answer",
            "config": {
              "type": "code",
              "code": "\n      const rows = context.nodes.find_ticket.output || []\n      if (!rows.length) {\n        return { found: false, status: \"No request found with that ticket id.\" }\n      }\n      const t = rows[0]\n      return {\n        found: true,\n        status: \"Request \" + t.ticket_id + \" (\" + t.urgency + \") was filed at \" + t.filed_at + \" and is with the service desk: \" + t.summary\n      }\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["found", "status"],
              "properties": {
                "found": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "edges": [
