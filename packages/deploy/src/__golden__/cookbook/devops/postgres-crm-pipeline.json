                "id": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "status": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": ["id", "email"]
            }
          },
          {
            "name": "lead_scores",
            "schema": {
              "type": "object",
              "properties": {
                "lead_id": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "tier": {
