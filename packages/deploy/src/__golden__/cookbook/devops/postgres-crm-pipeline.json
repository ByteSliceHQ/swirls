        "vars": ["DATABASE_URL"]
      }
    ],
    "authBlocks": [],
    "postgresBlocks": [
      {
        "id": "id-12",
        "name": "crm_db",
        "secretsRef": "db_creds",
        "connection": "DATABASE_URL",
        "connectionIsLiteral": false,
        "tables": [
          {
            "name": "leads",
