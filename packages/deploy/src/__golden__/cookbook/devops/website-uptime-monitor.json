              "type": "http",
              "url": " return context.secrets.monitor_config.MONITOR_URL ",
              "failurePolicy": {
                "strategy": "fallback",
                "fallbackValue": {}
              }
            },
            "reviewConfig": null,
            "secretsMap": {
              "monitor_config": ["MONITOR_URL"]
            },
            "configValueKinds": {
              "url": "ts"
            }
          },
          {
            "id": "id-5",
            "name": "evaluate",
            "type": "code",
            "label": "Evaluate response",
            "config": {
              "type": "code",
              "code": "\n      var statusCode = context.nodes.ping.meta ? context.nodes.ping.meta.status : 0\n      var isUp = statusCode >= 200 && statusCode < 400\n      return {\n        status: isUp ? \"up\" : \"down\",\n        status_code: statusCode,\n        timestamp: context.nodes.root.output.timestamp\n      }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-6",
            "name": "route",
            "type": "switch",
            "label": "Route by status",
            "config": {
              "type": "switch",
              "cases": ["up", "down"],
              "router": "\n      return context.nodes.evaluate.output.status\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-7",
            "name": "log_ok",
            "type": "code",
            "label": "Log healthy",
            "config": {
              "type": "code",
              "code": "\n      return {\n        status: \"up\",\n        checked_at: context.nodes.evaluate.output.timestamp\n      }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-8",
