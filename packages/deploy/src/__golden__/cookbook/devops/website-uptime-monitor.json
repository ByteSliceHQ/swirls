              "from": " return \"no-reply@transactional.byteslice.co\" ",
              "to": " return \"team@example.com\" ",
              "subject": " return \"ALERT: Website is DOWN\" ",
              "text": "\n      return \"Website is unreachable.\\nStatus code: \" + context.nodes.evaluate.output.status_code + \"\\nChecked at: \" + context.nodes.evaluate.output.timestamp\n    "
            },
