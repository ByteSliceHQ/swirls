    "schedules": [
      {
        "id": "id-1",
        "name": "hourly_weather",
        "label": "Hourly Weather",
        "cron": "0 * * * *"
      }
    ],
    "workflows": [
      {
        "id": "id-2",
        "name": "fetch_weather",
        "label": "Fetch Weather",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Prepare request",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": "\n      return { city: \"San Francisco\", units: \"imperial\" }\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "get_weather",
            "type": "http",
            "label": "Call weather API",
            "config": {
              "type": "http",
              "url": "\n      const params = context.nodes.root.output\n      const base = context.secrets.weather_creds.WEATHER_API_URL || \"https://api.openweathermap.org\"\n      return base + \"/data/2.5/weather?q=\" + params.city + \"&units=\" + params.units\n    "
            },
            "reviewConfig": null,
            "secretsMap": {
              "weather_creds": ["WEATHER_API_URL"]
            },
            "authRef": "weather_auth",
            "configValueKinds": {
              "url": "ts"
            }
          },
          {
            "id": "id-5",
            "name": "format",
            "type": "code",
            "label": "Format result",
            "config": {
              "type": "code",
              "code": "\n      const data = context.nodes.get_weather.output\n      return {\n        city: data.name || \"unknown\",\n        temp: data.main ? data.main.temp : 0,\n        description: data.weather && data.weather[0] ? data.weather[0].description : \"unknown\",\n        humidity: data.main ? data.main.humidity : 0\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
        "edges": [
          {
            "id": "id-6",
            "sourceNodeId": "id-3",
            "targetNodeId": "id-4"
          },
