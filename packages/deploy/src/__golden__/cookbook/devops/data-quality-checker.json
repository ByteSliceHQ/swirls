    "workflows": [
      {
        "id": "id-2",
        "name": "check_quality",
        "label": "Check Data Quality",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract record",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "payload": {
                  "type": "object"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "validate",
            "type": "code",
            "label": "Run validation rules",
            "config": {
              "type": "code",
              "code": "\n      const record = context.nodes.root.output\n      const issues = []\n\n      if (!record.payload || typeof record.payload !== \"object\") {\n        issues.push(\"payload is not an object\")\n      }\n\n      const keys = Object.keys(record.payload || {})\n      if (keys.length === 0) {\n        issues.push(\"payload is empty\")\n      }\n\n      for (const key of keys) {\n        if (record.payload[key] === null || record.payload[key] === undefined) {\n          issues.push(\"null value for key: \" + key)\n        }\n      }\n\n      return {\n        source: record.source,\n        field_count: keys.length,\n        issues: issues,\n        is_valid: issues.length === 0\n      }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-5",
            "name": "route",
            "type": "switch",
            "label": "Route by validity",
            "config": {
              "type": "switch",
              "cases": ["valid", "invalid"],
              "router": "\n      if (context.nodes.validate.output.is_valid) return \"valid\"\n      return \"invalid\"\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-6",
            "name": "accept",
            "type": "code",
            "label": "Accept record",
            "config": {
              "type": "code",
              "code": "\n      return {\n        status: \"accepted\",\n        source: context.nodes.validate.output.source,\n        fields: context.nodes.validate.output.field_count\n      }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-7",
            "name": "quarantine",
            "type": "code",
            "label": "Quarantine record",
            "config": {
              "type": "code",
              "code": "\n      return {\n        status: \"quarantined\",\n        source: context.nodes.validate.output.source,\n        issues: context.nodes.validate.output.issues\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
        "edges": [
