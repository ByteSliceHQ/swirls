    "workflows": [
      {
        "id": "id-2",
        "name": "fetch_repo_stats",
        "label": "Fetch Repo Stats",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Configure",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": "\n      return { repo: \"owner/repo\" }\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "fetch_repo",
            "type": "http",
            "label": "Fetch repo info",
            "config": {
              "type": "http",
              "url": "\n      const base = context.secrets.github_creds.GITHUB_API_URL || \"https://api.github.com\"\n      return base + \"/repos/\" + context.nodes.root.output.repo\n    "
            },
            "reviewConfig": null,
            "secretsMap": {
              "github_creds": ["GITHUB_API_URL"]
            },
            "authRef": "github_oauth",
            "configValueKinds": {
              "url": "ts"
            }
          },
          {
            "id": "id-5",
            "name": "extract",
            "type": "code",
            "label": "Extract stats",
            "config": {
              "type": "code",
              "code": "\n      const repo = context.nodes.fetch_repo.output\n      return {\n        name: repo.full_name || context.nodes.root.output.repo,\n        stars: repo.stargazers_count || 0,\n        forks: repo.forks_count || 0,\n        open_issues: repo.open_issues_count || 0,\n        watchers: repo.watchers_count || 0\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
