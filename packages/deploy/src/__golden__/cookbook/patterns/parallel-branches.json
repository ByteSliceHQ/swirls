            "name": "extract_keywords",
            "type": "ai",
            "label": "Extract keywords",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      return \"Extract 5-10 keywords from this article.\\n\\nTitle: \" + context.nodes.root.output.title + \"\\n\\n\" + context.nodes.root.output.body\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["keywords"],
              "properties": {
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "generate_summary",
            "type": "ai",
            "label": "Generate summary",
            "config": {
              "type": "ai",
              "kind": "text",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      return \"Write a 2-sentence summary of this article.\\n\\nTitle: \" + context.nodes.root.output.title + \"\\n\\n\" + context.nodes.root.output.body\n    "
            },
            "reviewConfig": null,
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-6",
            "name": "estimate_read_time",
            "type": "code",
            "label": "Estimate read time",
            "config": {
              "type": "code",
              "code": "\n      const words = context.nodes.root.output.body.split(\" \").length\n      return { read_time_minutes: Math.ceil(words / 200) }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-7",
            "name": "combine",
            "type": "code",
            "label": "Combine results",
            "config": {
              "type": "code",
              "code": "\n      return {\n        title: context.nodes.root.output.title,\n        author: context.nodes.root.output.author,\n        summary: context.nodes.generate_summary.output,\n        keywords: context.nodes.extract_keywords.output.keywords,\n        read_time: context.nodes.estimate_read_time.output.read_time_minutes\n      }\n    "
            },
            "reviewConfig": null
          }
