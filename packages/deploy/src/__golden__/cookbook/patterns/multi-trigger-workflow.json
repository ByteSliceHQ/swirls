        "label": "Process Message",
        "nodes": [
          {
            "id": "id-5",
            "name": "root",
            "type": "code",
            "label": "Normalize input",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": "\n      const input = context.nodes.root.input || {}\n      const triggerType = context.meta.triggerType\n      return {\n        message: input.message || \"Scheduled run at \" + new Date().toISOString(),\n        source: triggerType,\n        received_at: new Date().toISOString()\n      }\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "received_at": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-6",
            "name": "process",
            "type": "ai",
            "label": "Process message",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      return \"Analyze this message and extract key information.\\n\\nSource: \" + context.nodes.root.output.source + \"\\nMessage: \" + context.nodes.root.output.message\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["summary", "intent"],
              "properties": {
                "summary": {
                  "type": "string"
                },
                "intent": {
                  "type": "string"
                },
                "entities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-7",
            "name": "result",
            "type": "code",
            "label": "Format result",
            "config": {
              "type": "code",
              "code": "\n      return {\n        source: context.nodes.root.output.source,\n        message: context.nodes.root.output.message,\n        summary: context.nodes.process.output.summary,\n        intent: context.nodes.process.output.intent\n      }\n    "
            },
            "reviewConfig": null
          }
