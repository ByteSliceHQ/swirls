              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "reviewer_name": {
              "type": "string"
            }
          }
        }
      }
    ],
    "schedules": [],
    "workflows": [
      {
        "id": "id-2",
        "name": "analyze_review",
        "label": "Analyze Review Sentiment",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract review",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string"
                },
                "review_text": {
                  "type": "string"
                },
                "rating": {
                  "type": "number"
                },
                "reviewer_name": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "analyze",
            "type": "ai",
            "label": "Analyze sentiment",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const review = context.nodes.root.output\n      return \"Analyze the sentiment of this product review.\\n\\nRating: \" + review.rating + \"/5\\nReview: \" + review.review_text\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["sentiment", "score", "themes"],
              "properties": {
                "sentiment": {
                  "type": "string",
                  "enum": ["positive", "neutral", "negative", "mixed"]
                },
                "score": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "themes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "actionable_feedback": {
                  "type": "string"
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "result",
            "type": "code",
            "label": "Combine results",
            "config": {
              "type": "code",
              "code": "\n      const review = context.nodes.root.output\n      const analysis = context.nodes.analyze.output\n      return {\n        product_id: review.product_id,\n        rating: review.rating,\n        sentiment: analysis.sentiment,\n        score: analysis.score,\n        themes: analysis.themes,\n        actionable_feedback: analysis.actionable_feedback || \"\"\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
