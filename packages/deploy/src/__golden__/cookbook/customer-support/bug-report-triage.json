{
  "ok": true,
  "definition": {
    "forms": [
      {
        "id": "id-1",
        "name": "bug_report",
        "label": "Bug Report",
        "schema": {
          "type": "object",
          "required": ["title", "description", "reporter_email"],
          "properties": {
            "title": {
              "type": "string",
              "title": "Bug Title"
            },
            "description": {
              "type": "string",
              "title": "Description"
            },
            "steps_to_reproduce": {
              "type": "string",
              "title": "Steps to Reproduce"
            },
            "reporter_email": {
              "type": "string",
              "format": "email",
              "title": "Reporter Email"
            },
            "component": {
              "type": "string",
              "title": "Component",
              "enum": ["frontend", "backend", "api", "database", "infrastructure"]
            }
          }
        },
        "visibility": "internal"
      }
    ],
    "webhooks": [],
    "schedules": [],
    "workflows": [
      {
        "id": "id-2",
        "name": "triage_bug",
        "label": "Triage Bug Report",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract bug report",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "steps_to_reproduce": {
                  "type": "string"
                },
                "reporter_email": {
                  "type": "string"
                },
                "component": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "classify",
            "type": "ai",
            "label": "Classify bug",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const bug = context.nodes.root.output\n      return \"Classify this bug report.\\n\\nTitle: \" + bug.title + \"\\nComponent: \" + (bug.component || \"unknown\") + \"\\nDescription: \" + bug.description + \"\\nSteps: \" + (bug.steps_to_reproduce || \"not provided\")\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["severity", "priority", "category"],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": ["critical", "major", "minor", "trivial"]
                },
                "priority": {
                  "type": "string",
                  "enum": ["p0", "p1", "p2", "p3"]
                },
                "category": {
                  "type": "string",
                  "enum": ["crash", "data_loss", "performance", "ui", "functionality", "security"]
                },
                "suggested_assignee_team": {
                  "type": "string"
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "route_severity",
            "type": "switch",
            "label": "Route by severity",
            "config": {
              "type": "switch",
              "cases": ["critical", "standard"],
              "router": "\n      if (context.nodes.classify.output.severity === \"critical\") return \"critical\"\n      return \"standard\"\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-6",
            "name": "page_oncall",
            "type": "http",
            "label": "Page on-call",
            "config": {
              "type": "http",
              "url": " return context.secrets.triage_slack.SLACK_WEBHOOK_URL ",
              "method": "POST",
              "headers": " return { \"Content-Type\": \"application/json\" } ",
              "body": "\n      const bug = context.nodes.root.output\n      const cls = context.nodes.classify.output\n      return JSON.stringify({\n        text: \"CRITICAL BUG: \" + bug.title + \"\\nCategory: \" + cls.category + \"\\nPriority: \" + cls.priority + \"\\n\" + bug.description\n      })\n    "
            },
            "reviewConfig": null,
            "secretsMap": {
              "triage_slack": ["SLACK_WEBHOOK_URL"]
            },
            "configValueKinds": {
              "url": "ts",
              "body": "ts"
            }
          },
          {
            "id": "id-7",
            "name": "log_bug",
            "type": "code",
            "label": "Log triaged bug",
            "config": {
              "type": "code",
              "code": "\n      const bug = context.nodes.root.output\n      const cls = context.nodes.classify.output\n      return {\n        title: bug.title,\n        severity: cls.severity,\n        priority: cls.priority,\n        category: cls.category,\n        component: bug.component || \"unknown\",\n        team: cls.suggested_assignee_team || \"unassigned\"\n      }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-8",
            "name": "ack_reporter",
            "type": "email",
            "label": "Acknowledge reporter",
            "config": {
              "type": "email",
              "from": " return \"no-reply@transactional.byteslice.co\" ",
              "to": " return context.nodes.root.output.reporter_email ",
              "subject": " return \"Bug received: \" + context.nodes.root.output.title ",
              "text": "\n      return \"Thanks for reporting this bug. It has been triaged as \" + context.nodes.classify.output.priority + \" (\" + context.nodes.classify.output.severity + \"). Our team is on it.\"\n    "
            },
            "reviewConfig": null,
            "configValueKinds": {
              "from": "ts",
              "to": "ts",
              "subject": "ts",
              "text": "ts"
            }
          }
        ],
        "edges": [
          {
            "id": "id-9",
            "sourceNodeId": "id-3",
            "targetNodeId": "id-4"
          },
          {
            "id": "id-10",
            "sourceNodeId": "id-4",
            "targetNodeId": "id-5"
          },
          {
            "id": "id-11",
            "sourceNodeId": "id-5",
            "targetNodeId": "id-6",
            "label": "critical"
          },
          {
            "id": "id-12",
            "sourceNodeId": "id-5",
            "targetNodeId": "id-7",
            "label": "standard"
          },
          {
            "id": "id-13",
            "sourceNodeId": "id-4",
            "targetNodeId": "id-8"
          }
        ]
      }
    ],
    "schemas": [],
    "triggers": [
      {
        "id": "id-14",
        "name": "on_bug",
        "resourceType": "form",
        "resourceId": "id-1",
        "workflowId": "id-2",
        "enabled": true
      }
    ],
    "secretBlocks": [
