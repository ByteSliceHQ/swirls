{
  "ok": true,
  "definition": {
    "forms": [],
    "webhooks": [
      {
        "id": "id-1",
        "name": "support_interaction",
        "label": "Support Interaction",
        "schema": {
          "type": "object",
          "required": ["customer_email", "interaction_text", "channel"],
          "properties": {
            "customer_email": {
              "type": "string"
            },
            "interaction_text": {
              "type": "string"
            },
            "channel": {
              "type": "string",
              "enum": ["chat", "email", "phone"]
            },
            "agent_name": {
              "type": "string"
            }
          }
        }
      }
    ],
    "schedules": [],
    "workflows": [
      {
        "id": "id-2",
        "name": "score_csat",
        "label": "Score CSAT",
        "nodes": [
          {
            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract interaction",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "customer_email": {
                  "type": "string"
                },
                "interaction_text": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "agent_name": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "score",
            "type": "ai",
            "label": "Score satisfaction",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const interaction = context.nodes.root.output\n      return \"Score the customer satisfaction of this \" + interaction.channel + \" support interaction from 1-5.\\n\\n\" + interaction.interaction_text\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["score", "resolved", "customer_sentiment"],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                "resolved": {
                  "type": "boolean"
                },
                "customer_sentiment": {
                  "type": "string",
                  "enum": ["happy", "neutral", "frustrated", "angry"]
                },
                "improvement_notes": {
                  "type": "string"
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "route",
            "type": "switch",
            "label": "Route by score",
            "config": {
              "type": "switch",
              "cases": ["needs_followup", "ok"],
              "router": "\n      if (context.nodes.score.output.score <= 2) return \"needs_followup\"\n      return \"ok\"\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-6",
            "name": "followup",
            "type": "email",
            "label": "Send follow-up",
            "config": {
              "type": "email",
              "from": " return \"no-reply@transactional.byteslice.co\" ",
              "to": " return context.nodes.root.output.customer_email ",
              "subject": " return \"Following up on your support experience\" ",
              "text": "\n      return \"We noticed your recent support experience may not have met your expectations. We are committed to doing better. A senior support specialist will reach out within 24 hours to ensure your issue is fully resolved.\"\n    "
            },
            "reviewConfig": null,
            "configValueKinds": {
              "from": "ts",
              "to": "ts",
              "subject": "ts",
              "text": "ts"
            }
          },
          {
            "id": "id-7",
            "name": "store_result",
            "type": "code",
            "label": "Store score",
            "config": {
              "type": "code",
              "code": "\n      return {\n        customer: context.nodes.root.output.customer_email,\n        channel: context.nodes.root.output.channel,\n        score: context.nodes.score.output.score,\n        resolved: context.nodes.score.output.resolved,\n        sentiment: context.nodes.score.output.customer_sentiment\n      }\n    "
            },
            "reviewConfig": null
          }
        ],
        "edges": [
          {
            "id": "id-8",
            "sourceNodeId": "id-3",
            "targetNodeId": "id-4"
          },
          {
            "id": "id-9",
            "sourceNodeId": "id-4",
            "targetNodeId": "id-5"
          },
          {
            "id": "id-10",
            "sourceNodeId": "id-5",
            "targetNodeId": "id-6",
            "label": "needs_followup"
          },
          {
            "id": "id-11",
            "sourceNodeId": "id-5",
            "targetNodeId": "id-7",
            "label": "ok"
          }
        ]
      }
    ],
