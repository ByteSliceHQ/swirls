            "id": "id-3",
            "name": "root",
            "type": "code",
            "label": "Extract invoice",
            "isRoot": true,
            "config": {
              "type": "code",
              "code": " return context.nodes.root.input "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "vendor": {
                  "type": "string"
                },
