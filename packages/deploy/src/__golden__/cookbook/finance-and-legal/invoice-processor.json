                  "type": "string"
                }
              }
            }
          },
          {
            "id": "id-4",
            "name": "extract_details",
            "type": "ai",
            "label": "Extract line items",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      return \"Extract structured line items from this invoice.\\n\\nVendor: \" + context.nodes.root.output.vendor + \"\\nTotal: $\" + context.nodes.root.output.amount + \"\\n\\n\" + context.nodes.root.output.invoice_text\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["line_items", "total_matches"],
              "properties": {
                "line_items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "number"
                      },
                      "unit_price": {
                        "type": "number"
                      },
                      "total": {
                        "type": "number"
                      }
                    }
                  }
                },
                "total_matches": {
                  "type": "boolean"
                },
                "discrepancy_note": {
                  "type": "string"
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "check_anomaly",
            "type": "switch",
            "label": "Check for anomalies",
            "config": {
              "type": "switch",
              "cases": ["ok", "flagged"],
              "router": "\n      if (context.nodes.extract_details.output.total_matches) return \"ok\"\n      return \"flagged\"\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-6",
            "name": "approve",
            "type": "code",
            "label": "Auto-approve",
            "config": {
              "type": "code",
              "code": "\n      return {\n        status: \"approved\",\n        vendor: context.nodes.root.output.vendor,\n        amount: context.nodes.root.output.amount,\n        line_items: context.nodes.extract_details.output.line_items.length\n      }\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-7",
            "name": "flag",
            "type": "code",
            "label": "Flag for review",
            "config": {
              "type": "code",
              "code": "\n      return {\n        status: \"flagged\",\n        vendor: context.nodes.root.output.vendor,\n        amount: context.nodes.root.output.amount,\n        note: context.nodes.extract_details.output.discrepancy_note\n      }\n    "
            },
            "reviewConfig": null
          }
