            "label": "maybe"
          },
          {
            "id": "id-17",
            "sourceNodeId": "id-6",
            "targetNodeId": "id-7"
          },
          {
            "id": "id-18",
            "sourceNodeId": "id-7",
            "targetNodeId": "id-8",
            "label": "interview"
          },
          {
            "id": "id-19",
            "sourceNodeId": "id-7",
            "targetNodeId": "id-9",
            "label": "reject"
          }
        ]
      }
    ],
    "schemas": [],
    "triggers": [
      {
        "id": "id-20",
        "name": "on_application",
        "resourceType": "form",
        "resourceId": "id-1",
        "workflowId": "id-2",
        "enabled": true
      }
    ],
