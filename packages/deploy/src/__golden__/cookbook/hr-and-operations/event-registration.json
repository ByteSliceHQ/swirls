        "name": "registrations",
        "label": "Event registrations",
        "workflowName": "register_attendee",
        "version": "v1",
        "versions": {
          "v1": {
            "schema": {
              "type": "object",
              "required": ["name", "email", "event_name", "status"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "event_name": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            },
            "conditionCode": "return true",
            "prepareCode": "const reg = context.nodes.root.output\n        const status = context.output.confirm_registration != null ? \"registered\" : \"waitlisted\"\n        return {\n          name: reg.name,\n          email: reg.email,\n          event_name: reg.event_name,\n          company: reg.company || \"\",\n          status: status\n        }"
          }
        }
      }
