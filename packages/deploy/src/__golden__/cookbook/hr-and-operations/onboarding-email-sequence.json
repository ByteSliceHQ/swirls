              "to": " return context.nodes.root.output.email ",
              "subject": " return context.nodes.personalize.output.subject ",
              "text": "\n      const content = context.nodes.personalize.output\n      const steps = content.next_steps.map(function(step, i) { return (i + 1) + \". \" + step }).join(\"\\n\")\n      return content.body + \"\\n\\nYour next steps:\\n\" + steps\n    "
            },
