              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const user = context.nodes.root.output\n      return \"Write a personalized onboarding email for \" + user.name + \" on the \" + user.plan + \" plan. Use case: \" + (user.use_case || \"general\") + \". Include 3 specific next steps tailored to their plan. Keep it warm and actionable.\"\n    ",
