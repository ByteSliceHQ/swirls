            "id": "id-4",
            "name": "score",
            "type": "ai",
            "label": "Score the lead",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const lead = context.nodes.root.output\n      return \"Score this B2B lead from 0-100 based on likelihood to convert.\\n\\nEmail: \" + lead.email + \"\\nCompany: \" + lead.company + \"\\nSource: \" + lead.source + \"\\nJob title: \" + (lead.job_title || \"unknown\") + \"\\nCompany size: \" + (lead.company_size || \"unknown\")\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["score", "reasoning", "tier"],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "reasoning": {
                  "type": "string"
                },
                "tier": {
                  "type": "string",
                  "enum": ["hot", "warm", "cold"]
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "route",
            "type": "switch",
            "label": "Route by score",
            "config": {
              "type": "switch",
              "cases": ["hot", "other"],
              "router": "\n      if (context.nodes.score.output.tier === \"hot\") return \"hot\"\n      return \"other\"\n    "
            },
            "reviewConfig": null
          },
          {
            "id": "id-6",
            "name": "alert_sales",
            "type": "email",
            "label": "Alert sales team",
            "config": {
              "type": "email",
              "from": " return \"no-reply@transactional.byteslice.co\" ",
              "to": " return \"sales@example.com\" ",
              "subject": "\n      return \"Hot lead: \" + context.nodes.root.output.company + \" (Score: \" + context.nodes.score.output.score + \")\"\n    ",
              "text": "\n      const lead = context.nodes.root.output\n      const result = context.nodes.score.output\n      return \"New hot lead!\\n\\nCompany: \" + lead.company + \"\\nEmail: \" + lead.email + \"\\nScore: \" + result.score + \"\\nReason: \" + result.reasoning\n    "
            },
            "reviewConfig": null,
            "configValueKinds": {
              "from": "ts",
              "to": "ts",
              "subject": "ts",
              "text": "ts"
            }
