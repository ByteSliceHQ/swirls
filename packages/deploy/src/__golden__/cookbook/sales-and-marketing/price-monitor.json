      {
        "id": "id-22",
        "name": "price_history",
        "label": "Price history",
        "workflowName": "monitor_prices",
        "version": "v1",
        "versions": {
          "v1": {
            "schema": {
              "type": "object",
              "required": ["checked_at", "tier_count"],
              "properties": {
                "checked_at": {
                  "type": "string"
                },
                "tiers": {
                  "type": "array"
                },
                "tier_count": {
                  "type": "number"
                }
              }
            },
            "conditionCode": "return context.output.store_result != null",
            "prepareCode": "return context.output.store_result"
          }
        }
      }
    ],
