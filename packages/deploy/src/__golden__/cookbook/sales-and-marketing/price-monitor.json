          },
          {
            "id": "id-16",
            "sourceNodeId": "id-5",
            "targetNodeId": "id-8"
          },
          {
            "id": "id-17",
            "sourceNodeId": "id-6",
            "targetNodeId": "id-8"
          },
          {
            "id": "id-18",
            "sourceNodeId": "id-8",
            "targetNodeId": "id-9"
          },
          {
            "id": "id-19",
            "sourceNodeId": "id-9",
            "targetNodeId": "id-10",
            "label": "changed"
          },
          {
            "id": "id-20",
            "sourceNodeId": "id-9",
            "targetNodeId": "id-11",
            "label": "unchanged"
          }
        ]
      }
    ],
    "schemas": [],
    "triggers": [
      {
        "id": "id-21",
        "name": "on_price_check",
        "resourceType": "schedule",
        "resourceId": "id-1",
