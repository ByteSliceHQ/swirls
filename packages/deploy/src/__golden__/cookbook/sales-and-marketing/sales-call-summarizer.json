          {
            "id": "id-4",
            "name": "analyze",
            "type": "ai",
            "label": "Analyze call",
            "config": {
              "type": "ai",
              "kind": "object",
              "model": "google/gemini-2.5-flash",
              "prompt": "\n      const call = context.nodes.root.output\n      return \"Analyze this sales call transcript.\\n\\nRep: \" + call.rep_name + \"\\nProspect: \" + call.prospect_company + \"\\nDuration: \" + (call.call_duration_minutes || \"unknown\") + \" minutes\\n\\nTranscript:\\n\" + call.transcript\n    "
            },
            "reviewConfig": null,
            "outputSchema": {
              "type": "object",
              "required": ["summary", "deal_stage", "next_steps", "sentiment", "deal_probability"],
              "properties": {
                "summary": {
                  "type": "string"
                },
                "deal_stage": {
                  "type": "string",
                  "enum": [
                    "discovery",
                    "demo",
                    "proposal",
                    "negotiation",
                    "closed_won",
                    "closed_lost"
                  ]
                },
                "buying_signals": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "objections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "next_steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sentiment": {
                  "type": "string",
                  "enum": ["positive", "neutral", "negative"]
                },
                "deal_probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "configValueKinds": {
              "prompt": "ts",
              "model": "literal"
            }
          },
          {
            "id": "id-5",
            "name": "result",
            "type": "code",
            "label": "Format result",
            "config": {
              "type": "code",
              "code": "\n      const call = context.nodes.root.output\n      const analysis = context.nodes.analyze.output\n      return {\n        rep: call.rep_name,\n        company: call.prospect_company,\n        summary: analysis.summary,\n        stage: analysis.deal_stage,\n        probability: analysis.deal_probability,\n        sentiment: analysis.sentiment,\n        next_steps: analysis.next_steps\n      }\n    "
            },
            "reviewConfig": null
          }
