{
  "name": "swirls-workspace",
  "private": true,
  "description": "The Swirls language: definition schema, parser, validator, language server and editor support.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "editors/vscode"
    ],
    "catalog": {
      "@types/bun": "1.3.11",
      "@types/json-schema": "7.0.15",
      "ajv": "8.18.0",
      "tsup": "8.5.1",
      "typescript": "5.9.3",
      "zod": "4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@swirls/lsp' build && bun run --filter 'vscode-swirls' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:grammar": "cd editors/tree-sitter-swirls && npm test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings && bun run lint:deprecated",
    "lint:deprecated": "oxlint packages editors/vscode --type-aware -A all -D typescript/no-deprecated",
    "verify": "bun run typecheck && bun run test && bun run lint && bun run fmt:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2007"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@prisma/language-server@31.11.0": "patches/@prisma%2Flanguage-server@31.11.0.patch"
  }
}
