      "beginCaptures": {
        "1": { "name": "keyword.declaration.swirls" }
      },
      "end": "\\}",
      "patterns": [
        { "include": "#comment" },
        {
          "match": "\\b(canvas|text|text_muted|text_dim|surface|viewport|raised|active|field|border|brand|brand_foreground|brand_soft|warning|success|info|danger|radius)\\s*:",
          "captures": { "1": { "name": "keyword.other.swirls" } }
