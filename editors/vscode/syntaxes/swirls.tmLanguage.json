        {
          "name": "string.quoted.single.swirls",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "comment.line.number-sign.swirls",
          "match": "(?<=^|\\s)#.*$"
        },
        {
          "begin": "\\{",
