    "policy-grant-line": {
      "name": "meta.policy-grant.swirls",
      "match": "\\b(allow|deny)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(->)\\s*(agent)\\s+(\\*|[a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.swirls" },
        "2": { "name": "entity.name.type.swirls" },
        "3": { "name": "keyword.operator.arrow.swirls" },
        "4": { "name": "keyword.other.swirls" },
        "5": { "name": "entity.name.type.swirls" }
      }
    },
    "grant-body-block": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#policy-grant-body" }]
    },
    "policy-grant-body": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#property-key" },
        { "include": "#property" },
        { "include": "#value" },
        { "include": "#brace-block" }
      ]
    },
    "property-key": {
      "patterns": [
        {
          "name": "meta.key-value.swirls",
          "match": "\\b(type)\\s*:",
          "captures": { "1": { "name": "keyword.other.swirls" } }
        },
        {
          "match": "\\b(label|description|enabled|schema|cron|timezone|version|name|model|provider|agent|decision|disk|temperature|maxTokens|maxSteps|tools|system|role|command|id|region|connection|connector|network|action|encoding|scopes|tables|visibility|platform|integration|url|method|headers|body|from|to|subject|text|html|replyTo|code|prompt|outputs|filter|path|operation|amount|unit|secondsFromConfig|inputSchema|outputSchema|review|vars|secrets|auth|grant_type|client_id|client_secret|token_url|query_param|scope|key|header|username|password|token|condition|prepare|workflow|workflows|cases|router|kind|stream|streamId|streams|columns|graph|input|output|items|maxItems|maxIterations|concurrency|update|select|insert|delete|params|objective|urls|searchQueries|mode|excerpts|fullContent|excerptsMaxCharsPerResult|excerptsMaxCharsTotal|apps|channels|forms|webhooks|services|databases|database|connections|mocks|tags|timeout|retries|skip|dataset|judge|expect|status|duration|severity|budget|called|notCalled|order|includes|matches|equals|similar|events|only|except|generate|formData|auto|instructions|rubric|criteria|minScore|max)\\s*:",
          "captures": { "1": { "name": "keyword.other.swirls" } }
        }
      ]
    },
    "property": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
      "captures": { "1": { "name": "keyword.other.swirls" } }
    },
    "value": {
      "patterns": [
        { "name": "constant.language.swirls", "match": "\\b(true|false)\\b" },
        {
          "name": "constant.language.node-type.swirls",
          "match": "\\b(agent|ai|code|database|decision|device|disk|email|fanout|workflow|http|integration|map|parallel|postgres|scrape|search|shell|stream|switch|wait|while)\\b"
        },
        {
          "name": "constant.language.auth-kind.swirls",
          "match": "\\b(oauth|api_key|basic|bearer|client_credentials)\\b"
        },
        {
          "name": "constant.language.mock-mode.swirls",
          "match": "\\b(all|off|selective)\\b"
        },
        {
          "name": "constant.language.review-auto.swirls",
          "match": "\\b(approve|reject)\\b"
        },
        {
          "name": "constant.language.expect-status.swirls",
          "match": "\\b(completed|failed|waiting)\\b"
        },
        {
          "name": "constant.language.severity.swirls",
          "match": "\\b(soft|gate)\\b"
        },
        {
          "name": "string.quoted.double.swirls",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.swirls", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.numeric.swirls",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "edge": {
      "patterns": [
        {
          "name": "meta.edge.labeled.swirls",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(-\\[)(\"(?:[^\"\\\\]|\\\\.)*\")(\\]->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.swirls" },
            "2": { "name": "keyword.operator.arrow.swirls" },
            "3": { "name": "string.quoted.double.swirls" },
            "4": { "name": "keyword.operator.arrow.swirls" },
            "5": { "name": "entity.name.type.swirls" }
          }
        },
        {
          "name": "meta.edge.swirls",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.swirls" },
            "2": { "name": "keyword.operator.arrow.swirls" },
            "3": { "name": "entity.name.type.swirls" },
            "4": { "name": "keyword.operator.arrow.swirls" },
            "5": { "name": "entity.name.type.swirls" }
          }
        }
      ]
    },
    "trigger-binding": {
      "name": "meta.trigger-binding.swirls",
      "match": "\\b(form|webhook|schedule)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.swirls" },
        "2": { "name": "entity.name.type.swirls" },
        "3": { "name": "keyword.operator.arrow.swirls" },
        "4": { "name": "entity.name.type.swirls" }
      }
    },
    "at-ts-file-ref": {
      "name": "meta.at-ts-file-ref.swirls",
      "begin": "(@ts)(\\s*)(\\\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.swirls" },
        "2": { "name": "white.space.swirls" },
        "3": { "name": "punctuation.definition.string.begin.swirls" }
      },
      "end": "\\\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.swirls" }
